<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="chips/" />
        <exclude domain="database" path="portaalerta.db" />
        <exclude domain="database" path="portaalerta.db-wal" />
        <exclude domain="database" path="portaalerta.db-shm" />
    </cloud-backup>
    <device-transfer>
        <!-- Al cambiar de teléfono por cable o Wi-Fi directo, los clientes se pueden pasar; las fotos no. -->
        <exclude domain="file" path="chips/" />
    </device-transfer>
</data-extraction-rules>
